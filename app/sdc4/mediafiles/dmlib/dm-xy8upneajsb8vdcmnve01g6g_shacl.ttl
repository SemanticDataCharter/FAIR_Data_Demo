@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sdc4: <https://semanticdatacharter.com/ns/sdc4/> .
@prefix sdc4-meta: <https://semanticdatacharter.com/ontology/sdc4-meta/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sdc4:AttestationBaseShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Attestation view must be a string" ;
            sh:minCount 0 ;
            sh:path sdc4:attestation-view ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Attestation proof must be a string" ;
            sh:minCount 0 ;
            sh:path sdc4:attestation-proof ] ;
    sh:targetClass sdc4:AttestationType .

sdc4:AuditBaseShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "Audit must have a timestamp" ;
            sh:minCount 1 ;
            sh:path sdc4:audit-time ],
        [ sh:class sdc4:PartyType ;
            sh:maxCount 1 ;
            sh:message "Audit committer must be a Party" ;
            sh:minCount 0 ;
            sh:path sdc4:audit-committer ] ;
    sh:targetClass sdc4:AuditType .

sdc4:ParticipationBaseShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Participation function must be a string" ;
            sh:minCount 0 ;
            sh:path sdc4:participation-function ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Participation mode must be a string" ;
            sh:minCount 0 ;
            sh:path sdc4:participation-mode ] ;
    sh:targetClass sdc4:ParticipationType .

sdc4:PartyBaseShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Party must have a name" ;
            sh:minCount 1 ;
            sh:path sdc4:party-name ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Party ID must be a string" ;
            sh:minCount 0 ;
            sh:path sdc4:party-id ] ;
    sh:targetClass sdc4:PartyType .

sdc4:ReferenceRangeBaseShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "ReferenceRange must have a meaning" ;
            sh:minCount 1 ;
            sh:path sdc4:range-meaning ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "ReferenceRange lower bound must be a decimal" ;
            sh:minCount 0 ;
            sh:path sdc4:range-lower ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "ReferenceRange upper bound must be a decimal" ;
            sh:minCount 0 ;
            sh:path sdc4:range-upper ] ;
    sh:targetClass sdc4:ReferenceRangeType .

sdc4:SDC4ComponentShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "All SDC4 components must have a label" ;
            sh:minCount 1 ;
            sh:path rdfs:label ],
        [ sh:class rdfs:Class ;
            sh:message "All SDC4 components must have an rdf:type" ;
            sh:minCount 1 ;
            sh:path rdf:type ] ;
    sh:targetClass rdfs:Class .

sdc4:SimpleReferenceRangeBaseShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "SimpleReferenceRange lower bound must be a decimal" ;
            sh:minCount 0 ;
            sh:path sdc4:simple-range-lower ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "SimpleReferenceRange upper bound must be a decimal" ;
            sh:minCount 0 ;
            sh:path sdc4:simple-range-upper ] ;
    sh:targetClass sdc4:SimpleReferenceRangeType .

sdc4:UnitsBaseShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Units must have a label" ;
            sh:minCount 1 ;
            sh:path sdc4:label ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Units code must be a string" ;
            sh:minCount 0 ;
            sh:path sdc4:units-code ] ;
    sh:targetClass sdc4:UnitsType .

sdc4:XdBooleanBaseShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "XdBoolean must have a label" ;
            sh:minCount 1 ;
            sh:path sdc4:label ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:message "XdBoolean must have a boolean value" ;
            sh:minCount 1 ;
            sh:path sdc4:xdboolean-value ] ;
    sh:targetClass sdc4:XdBooleanType .

sdc4:XdDoubleBaseShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "XdDouble must have a label" ;
            sh:minCount 1 ;
            sh:path sdc4:label ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:message "XdDouble must have a double value" ;
            sh:minCount 1 ;
            sh:path sdc4:xddouble-value ],
        [ sh:class sdc4:UnitsType ;
            sh:maxCount 1 ;
            sh:message "XdDouble requires a Units component" ;
            sh:minCount 1 ;
            sh:path sdc4-meta:hasUnit ] ;
    sh:targetClass sdc4:XdDoubleType .

sdc4:XdFileBaseShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "XdFile must have a label" ;
            sh:minCount 1 ;
            sh:path sdc4:label ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:message "XdFile must have a valid URI" ;
            sh:minCount 1 ;
            sh:path sdc4:xdfile-uri ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "XdFile media type must be a string" ;
            sh:minCount 0 ;
            sh:path sdc4:xdfile-media-type ] ;
    sh:targetClass sdc4:XdFileType .

sdc4:XdFloatBaseShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "XdFloat must have a label" ;
            sh:minCount 1 ;
            sh:path sdc4:label ],
        [ sh:datatype xsd:float ;
            sh:maxCount 1 ;
            sh:message "XdFloat must have a float value" ;
            sh:minCount 1 ;
            sh:path sdc4:xdfloat-value ],
        [ sh:class sdc4:UnitsType ;
            sh:maxCount 1 ;
            sh:message "XdFloat requires a Units component" ;
            sh:minCount 1 ;
            sh:path sdc4-meta:hasUnit ] ;
    sh:targetClass sdc4:XdFloatType .

sdc4:XdIntervalBaseShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "XdInterval must have a label" ;
            sh:minCount 1 ;
            sh:path sdc4:label ],
        [ sh:maxCount 1 ;
            sh:message "XdInterval lower bound is optional" ;
            sh:minCount 0 ;
            sh:path sdc4:xdinterval-lower ],
        [ sh:maxCount 1 ;
            sh:message "XdInterval upper bound is optional" ;
            sh:minCount 0 ;
            sh:path sdc4:xdinterval-upper ] ;
    sh:targetClass sdc4:XdIntervalType .

sdc4:XdOrdinalBaseShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "XdOrdinal must have a label" ;
            sh:minCount 1 ;
            sh:path sdc4:label ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:message "XdOrdinal must have an integer value" ;
            sh:minCount 1 ;
            sh:path sdc4:xdordinal-value ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "XdOrdinal symbol must be a string" ;
            sh:minCount 0 ;
            sh:path sdc4:xdordinal-symbol ] ;
    sh:targetClass sdc4:XdOrdinalType .

sdc4:mc-fl5quyfd88rajs0egsgbq7ou-shape a sh:NodeShape ;
    rdfs:label "FAIR Source File" ;
    sh:node sdc4:ClusterBaseShape ;
    sh:property [ sh:hasValue <https://axius-sdc.com/library/fair/fair-source-file> ;
            sh:path dcterms:identifier ],
        [ sh:node sdc4:mc-q0ckidtsg1x3iav6nrt8fo0l-shape ;
            sh:path sdc4:hasCluster ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue prov:Entity ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://github.com/SemanticDataCharter/FAIR_Data_Demo> ;
            sh:path dcterms:source ] ;
    sh:targetNode sdc4:mc-fl5quyfd88rajs0egsgbq7ou .

sdc4:mc-k3rgauqfh9vs4bqq5q4nsbp4-shape a sh:NodeShape ;
    rdfs:label "FAIR Pipeline Identifier" ;
    rdfs:comment "The identifier of the pipeline that created the record from a federal source file (PROV agent identifier; the audit's system id)." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:hasValue prov:SoftwareAgent ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <https://github.com/SemanticDataCharter/FAIR_Data_Demo> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com/library/fair/fair-system-identifier> ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 120 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ] ;
    sh:targetNode sdc4:mc-k3rgauqfh9vs4bqq5q4nsbp4 ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-xy8upneajsb8vdcmnve01g6g-shape a sh:NodeShape ;
    rdfs:label "NHANES Participant" ;
    sh:node sdc4:DMBaseShape ;
    sh:property [ sh:maxCount 1 ;
            sh:message "Data Model must have a root data Cluster" ;
            sh:minCount 1 ;
            sh:node sdc4:mc-l6t9agg233vswxyv60quiu6w-shape ;
            sh:path sdc4:dm-data ] ;
    sh:targetNode sdc4:mc-xy8upneajsb8vdcmnve01g6g ;
    sdc4-meta:generatedAt "2026-09-26T22:14:43.623123+00:00"^^xsd:dateTime .

sdc4:DMBaseShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Data Model must have a label" ;
            sh:minCount 1 ;
            sh:path sdc4:dm-label ],
        [ sh:datatype xsd:language ;
            sh:maxCount 1 ;
            sh:message "Data Model must specify a language" ;
            sh:minCount 1 ;
            sh:path sdc4:dm-language ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Data Model must specify encoding" ;
            sh:minCount 1 ;
            sh:path sdc4:dm-encoding ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Data Model must have a mandatory instance_id (CUID2)" ;
            sh:minCount 1 ;
            sh:path sdc4:instance_id ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path sdc4:source_instance_id ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path sdc4:source_version_id ] ;
    sh:targetClass sdc4:DMType .

sdc4:XdLinkBaseShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "XdLink must have a label" ;
            sh:minCount 1 ;
            sh:path sdc4:label ],
        [ sh:datatype xsd:anyURI ;
            sh:maxCount 1 ;
            sh:message "XdLink must have a valid URI" ;
            sh:minCount 1 ;
            sh:path sdc4:xdlink-url ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "XdLink relation must be a string" ;
            sh:minCount 0 ;
            sh:path sdc4:xdlink-relation ] ;
    sh:targetClass sdc4:XdLinkType .

