# Lab Results Interoperability
# Shows laboratory result components with shared units and reference ranges.
# Demonstrates that identically-modeled CDEs produce structurally compatible data.
#
# NOTE: These queries use a placeholder sdc4: vocabulary. They will be
# rewritten once real RDF triples are generated from SDCStudio models.
# Actual SDCStudio RDF output uses sdc4-meta: predicates, not this
# placeholder vocabulary.

PREFIX sdc4: <https://datacharterontology.org/sdc4/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?ctId ?label ?study ?units ?referenceRange ?dataType
WHERE {
    ?component a sdc4:Component ;
               sdc4:ctId ?ctId ;
               rdfs:label ?label ;
               sdc4:domain "Laboratory Results" ;
               sdc4:study ?study ;
               sdc4:dataType ?dataType .
    OPTIONAL { ?component sdc4:units ?units . }
    OPTIONAL { ?component sdc4:referenceRange ?referenceRange . }
}
ORDER BY ?label ?study
