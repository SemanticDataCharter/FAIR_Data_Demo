# FAIR Data Demo — Environment Configuration
# Copy to .env and adjust as needed

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=fair_demo
POSTGRES_USER=fair_demo
POSTGRES_PASSWORD=fair_demo_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

# GraphDB
GRAPHDB_URL=http://graphdb:7200
GRAPHDB_REPOSITORY=fair_demo

# Redis
REDIS_URL=redis://redis:6379/0

# Service Ports (host-side)
WEB_PORT=8000
GRAPHDB_PORT=7200
POSTGRES_PORT_HOST=5433
REDIS_PORT_HOST=6380
