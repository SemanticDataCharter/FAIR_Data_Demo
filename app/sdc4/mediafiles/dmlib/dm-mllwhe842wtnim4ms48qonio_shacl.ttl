            sh:path sdc4:xdtoken-value ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <https://axius-sdc.com/library/fhir/admit-source> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue sdc4:mc-d6fhrxgpx4yrg0wyqu29ryvv ;
            sh:path prov:wasRevisionOf ],
        [ sh:hasValue <http://hl7.org/fhir/R4/encounter-definitions.html#Encounter.hospitalization.admitSource> ;
            sh:path skos:closeMatch ],
        [ sh:hasValue <http://hl7.org/fhir/R4/> ;
            sh:path dcterms:source ],
        [ sh:hasValue <http://terminology.hl7.org/CodeSystem/admit-source> ;
            sh:path skos:exactMatch ] ;
    sh:targetNode sdc4:mc-awvbv44gmq5co6prxcnhdz09 ;
    sdc4-meta:sdcType "XdTokenType" .

