    sh:node sdc4:XdTokenBaseShape ;
    sh:property [ sh:hasValue <http://terminology.hl7.org/CodeSystem/v3-ActReason> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <http://terminology.hl7.org/> ;
            sh:path dcterms:source ],
        [ sh:hasValue sdc4:mc-y87ikto4p56zlkx4o2d63ain ;
            sh:path prov:wasRevisionOf ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/purpose-of-use> ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:token ;
            sh:in ( "TREAT" "ETREAT" "COC" "HPAYMT" "HOPERAT" "HRESCH" "CLINTRCH" "PUBHLTH" "PATRQT" "HLEGAL" "HMARKT" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ] ;
    sh:targetNode sdc4:mc-d1evlz8yvdlwt6ia9fjq4pgj ;
    sdc4-meta:sdcType "XdTokenType" .

