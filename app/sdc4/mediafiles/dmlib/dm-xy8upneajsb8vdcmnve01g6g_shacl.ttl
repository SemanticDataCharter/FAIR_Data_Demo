            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ],
        [ sh:hasValue <http://purl.obolibrary.org/obo/NCIT_C16564> ;
            sh:path skos:closeMatch ],
        [ sh:hasValue <https://cde.nlm.nih.gov/deView?tinyId=LakF0YkywC> ;
