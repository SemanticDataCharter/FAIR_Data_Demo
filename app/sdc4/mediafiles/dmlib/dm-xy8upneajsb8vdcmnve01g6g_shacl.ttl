sdc4:mc-acr1xvqppf1b3rjsrst6tt4p-shape a sh:NodeShape ;
    rdfs:label "Condition: Asthma" ;
    rdfs:comment "Whether the person has asthma (Asthma, SNOMED CT 195967001), on the basis the record states in its Condition Indicator Basis: told by a health professional, or found in claims. Carried by NHANES MCQ010, BRFSS ASTHMA3." ;
    sh:node sdc4:XdTokenBaseShape ;
    sh:property [ sh:hasValue <https://github.com/SemanticDataCharter/FAIR_Data_Demo> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:datatype xsd:token ;
            sh:in ( "Yes" "No" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ],
        [ sh:hasValue <http://snomed.info/id/195967001> ;
            sh:path dcterms:subject ],
        [ sh:hasValue <https://axius-sdc.com/library/fair/condition-asthma> ;
            sh:path dcterms:identifier ] ;
    sh:targetNode sdc4:mc-acr1xvqppf1b3rjsrst6tt4p ;
    sdc4-meta:sdcType "XdTokenType" .

