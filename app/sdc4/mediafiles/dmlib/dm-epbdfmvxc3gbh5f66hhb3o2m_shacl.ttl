            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ],
        [ sh:hasValue <http://hl7.org/fhir/R4/> ;
            sh:path dcterms:source ],
        [ sh:hasValue <http://hl7.org/fhir/audit-event-action> ;
            sh:path skos:exactMatch ] ;
    sh:targetNode sdc4:mc-ce1c8sydkov8bkv4dgdmwe5x ;
