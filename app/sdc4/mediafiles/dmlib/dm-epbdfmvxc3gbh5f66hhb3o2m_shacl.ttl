sdc4:mc-a1zr74c1vayeeglk54da7gaf-shape a sh:NodeShape ;
    rdfs:label "Taken Prescription Medicine, Past Month (RXDUSE)" ;
    rdfs:comment "Whether the participant took prescription medicine in the past 30 days (RXDUSE)." ;
    sh:node sdc4:XdTokenBaseShape ;
    sh:property [ sh:datatype xsd:token ;
            sh:in ( "Yes" "No" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ],
        [ sh:hasValue <https://wwwn.cdc.gov/nchs/nhanes/continuousnhanes/default.aspx?BeginYear=2017> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://wwwn.cdc.gov/Nchs/Nhanes/2017-2018/RXQ_RX_J.htm#RXDUSE> ;
            sh:path rdfs:seeAlso ],
        [ sh:hasValue <https://axius-sdc.com/library/fair/nhanes-taken-prescription-past-month> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ] ;
    sh:targetNode sdc4:mc-a1zr74c1vayeeglk54da7gaf ;
    sdc4-meta:sdcType "XdTokenType" .

