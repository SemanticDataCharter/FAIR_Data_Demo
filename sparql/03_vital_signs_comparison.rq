# Vital Signs Distribution Comparison
# Compares vital signs components across studies — shared units, ranges, constraints.
#
# NOTE: These queries use a placeholder sdc4: vocabulary. They will be
# rewritten once real RDF triples are generated from SDCStudio models.
# Actual SDCStudio RDF output uses sdc4-meta: predicates, not this
# placeholder vocabulary.

PREFIX sdc4: <https://datacharterontology.org/sdc4/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?component ?label ?study ?units ?minInclusive ?maxInclusive
WHERE {
    ?component a sdc4:Component ;
               rdfs:label ?label ;
               sdc4:domain "Vital Signs" ;
               sdc4:study ?study .
    OPTIONAL { ?component sdc4:units ?units . }
    OPTIONAL { ?component sdc4:minInclusive ?minInclusive . }
    OPTIONAL { ?component sdc4:maxInclusive ?maxInclusive . }
}
ORDER BY ?label ?study
