# Shared CDE Component Audit
# Identifies which CDE components are used by multiple studies vs. study-specific.
# Components appearing in 2+ studies demonstrate structural reuse.
#
# NOTE: This query expresses the TARGET cross-study join pattern. It uses an
# illustrative placeholder vocabulary; SDCStudio RDF uses sdc4-meta: predicates.
# It is not yet runnable against the current models: the three studies share no
# ct_ids because their concepts have not been canonicalized to common components
# (an expert-reviewed, human-in-the-loop step). See ../README.md, section
# "Current Limitations and Future Work".

PREFIX sdc4: <https://datacharterontology.org/sdc4/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?ctId ?label ?domain (COUNT(DISTINCT ?study) AS ?studyCount) (GROUP_CONCAT(DISTINCT ?study; separator=", ") AS ?studies)
WHERE {
    ?component a sdc4:Component ;
               sdc4:ctId ?ctId ;
               rdfs:label ?label ;
               sdc4:domain ?domain ;
               sdc4:study ?study .
}
GROUP BY ?ctId ?label ?domain
ORDER BY DESC(?studyCount) ?domain ?label
