    rdfs:comment "Difficulty Dressing or Bathing (DIFFDRES), the American Community Survey disability question as BRFSS asks it." ;
    rdfs:seeAlso <https://www.cdc.gov/brfss/annual_data/2022/pdf/codebook22_llcp-v2-508.pdf> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-zc6p008h5naqev8zngtzvyx9 a sdc4-meta:ModelComponent ;
    rdfs:label "Condition: Stroke" ;
    rdfs:comment "Whether the person has stroke (Stroke, SNOMED CT 230690007), on the basis the record states in its Condition Indicator Basis: told by a health professional, or found in claims. Carried by NHANES MCQ160F, BRFSS CVDSTRK3, CMS SP_STRKETIA." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-i16vqj89it3db7d3c5qjko9p a sdc4-meta:ModelComponent ;
    rdfs:label "PROV Agent Type" ;
    rdfs:comment "The kind of PROV agent: person, organization or software agent." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-kzni1q04rghj23ca0zbhauu5 a sdc4-meta:ModelComponent ;
    rdfs:label "Frequency of Days Now Smoking (SMOKDAY2)" ;
    rdfs:comment "Whether the respondent now smokes cigarettes every day, some days or not at all (SMOKDAY2)." ;
    rdfs:seeAlso <https://www.cdc.gov/brfss/annual_data/2022/pdf/codebook22_llcp-v2-508.pdf> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-owjt9bcgisxfbco8qnddo2fq a sdc4-meta:ModelComponent ;
    rdfs:label "Are you pregnant now?" ;
    rdfs:comment "A textual description of the person's current pregnancy status. Also known as: Current Pregnancy Indicator. NIH CDE Repository, steward Project 5, tinyId LiUWCWluP, NIH endorsed." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-yht0x4rmqyu32sd90jl0rzbo a sdc4-meta:ModelComponent ;
    rdfs:label "Days" ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdStringType> .

sdc4:mc-ecwiva31y2fky3eu1mdnvurt a sdc4-meta:ModelComponent ;
    rdfs:label "Current E-cigarette Use (ECIGNOW2)" ;
    rdfs:comment "Whether the respondent now uses e-cigarettes every day, some days, or not at all, or never used them (ECIGNOW2)." ;
    rdfs:seeAlso <https://www.cdc.gov/brfss/annual_data/2022/pdf/codebook22_llcp-v2-508.pdf> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-ezewpvppvx8zjikutr53ppgz a sdc4-meta:ModelComponent ;
    rdfs:label "Computed Body Mass Index Category (_BMI5CAT)" ;
    rdfs:comment "The agency's computed BMI category (_BMI5CAT)." ;
    rdfs:seeAlso <https://www.cdc.gov/brfss/annual_data/2022/pdf/codebook22_llcp-v2-508.pdf> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-g2xnh3uhnlrnqlo7ki2s0fs3 a sdc4-meta:ModelComponent ;
    rdfs:label "PROV Derivation Type" ;
    rdfs:comment "How one entity was derived from another: a general derivation, a revision, a quotation or a primary source." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-gxzbm758mhdz51xd4bawlfhh a sdc4-meta:ModelComponent ;
    rdfs:label "Administrative Gender" ;
    rdfs:comment "The gender a person is recorded as for administrative purposes. Not clinical or biological sex; see Sex (Recorded)." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-iwlb0rcomw3q8rlff3ajukme a sdc4-meta:ModelComponent ;
    rdfs:label "Computed Smoking Status (_SMOKER3)" ;
    rdfs:comment "The agency's four-level computed smoking status (_SMOKER3). The shared Smoking Status beside it is derived from the same answers." ;
    rdfs:seeAlso <https://www.cdc.gov/brfss/annual_data/2022/pdf/codebook22_llcp-v2-508.pdf> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-rpz1czz06jhpahmfz30rblvp a sdc4-meta:ModelComponent ;
    rdfs:label "Audit Event Outcome" ;
    rdfs:comment "The result of an audited event (FHIR AuditEvent.outcome)." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-ce1c8sydkov8bkv4dgdmwe5x a sdc4-meta:ModelComponent ;
    rdfs:label "Audit Event Action" ;
    rdfs:comment "The operation performed in a logged access event (FHIR AuditEvent.action). Read and Execute change no state and are audit facts, not workflow moves." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-fa0aian3co6if5igu488whhr a sdc4-meta:ModelComponent ;
    rdfs:label "Length of Time Since Last Routine Checkup (CHECKUP1)" ;
    rdfs:comment "How long since the respondent last visited a doctor for a routine checkup (CHECKUP1)." ;
    rdfs:seeAlso <https://www.cdc.gov/brfss/annual_data/2022/pdf/codebook22_llcp-v2-508.pdf> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-i4e2nod7ss9d4cumhn2pah8b a sdc4-meta:ModelComponent ;
    rdfs:label "PROV Entity Type" ;
    rdfs:comment "The kind of PROV entity: a plain entity, a collection, an empty collection, a bundle or a plan." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-lth27h6towue4i9iq1cudogc a sdc4-meta:ModelComponent ;
    rdfs:label "General Health Status" ;
    rdfs:comment "The person's rating of their general health (BRFSS GENHLTH; the NHANES HSQ question is the same scale when that file is carried)." ;
    rdfs:seeAlso <https://www.cdc.gov/brfss/annual_data/2022/pdf/codebook22_llcp-v2-508.pdf> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-luq973ggnjoo9ixkt0dym8v6 a sdc4-meta:ModelComponent ;
    rdfs:label "Category of Health Insurance" ;
    rdfs:comment "A textual description of a person's insurance coverage for medical expenses. Question text: Category of Health Insurance? NIH CDE Repository, steward Project 5, tinyId cPiK4Amjn5, NIH endorsed." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-n7pn5ctqo81v0v418hez5zv5 a sdc4-meta:ModelComponent ;
    rdfs:label "Smoking Status" ;
    rdfs:comment "Tobacco smoking status (LOINC 72166-2) as the survey establishes it: NHANES from SMQ020 and SMQ040, BRFSS from SMOKE100 and SMOKDAY2 (the agency's _SMOKER3 is kept beside it). The LOINC answer list LL2201-3." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-czh5vzmdeijkwrtyla1w7su8 a sdc4-meta:ModelComponent ;
    rdfs:label "Marital Status (MARITAL)" ;
    rdfs:comment "Marital status as BRFSS codes it (MARITAL). Kept beside the NIH CDE Marital Status it is mapped to." ;
    rdfs:seeAlso <https://www.cdc.gov/brfss/annual_data/2022/pdf/codebook22_llcp-v2-508.pdf> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-fci5gajaodxc2ihq6nuz9l6y a sdc4-meta:ModelComponent ;
    rdfs:label "Education Level (EDUCA)" ;
    rdfs:comment "The highest grade or year of school completed (EDUCA). Kept beside the NIH CDE Current Educational Attainment it is mapped to." ;
    rdfs:seeAlso <https://www.cdc.gov/brfss/annual_data/2022/pdf/codebook22_llcp-v2-508.pdf> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-qamg60snb8cl9auv4y03kdc4 a sdc4-meta:ModelComponent ;
    rdfs:label "Imputed Race/Ethnicity Value (_IMPRACE)" ;
    rdfs:comment "Race and ethnicity as BRFSS imputes and codes it (_IMPRACE). Kept beside the NIH CDE Race/Ethnicity Self-Identification it is mapped to." ;
    rdfs:seeAlso <https://www.cdc.gov/brfss/annual_data/2022/pdf/codebook22_llcp-v2-508.pdf> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-vbctgmdcwps5b3r3l6sboa6y a sdc4-meta:ModelComponent ;
    rdfs:label "Confidentiality" ;
    rdfs:comment "The level of protection the information requires (HL7 v3 Confidentiality). At assembly the value populates a component's act tag." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-wl6j4ekcmu4hvt2m12zw4zp8 a sdc4-meta:ModelComponent ;
    rdfs:label "Activity Status" ;
    rdfs:comment "The state of an activity, from the Data Privacy Vocabulary activity status concepts." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-u5tietya3u56hbz2kos06ai7 a sdc4-meta:ModelComponent ;
    rdfs:label "Race/Ethnicity Self-Identification" ;
    rdfs:comment "A textual description of a person's race. C17049 |The ethnicity of a person. C16564 | An individual's perspective or subjective interpretation of an event or information. C74528 Question text: Please select the racial/ethnic category or categories with which you most closely identify. Select all that apply. NIH CDE Repository, steward NIMHD, tinyId LakF0YkywC, NIH endorsed." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-j67yf27qljb83m2fwvown1lk a sdc4-meta:ModelComponent ;
    rdfs:label "Employment Status (EMPLOY1)" ;
    rdfs:comment "Employment status as BRFSS codes it (EMPLOY1). Kept beside the NIH CDE Employment Status it is mapped to." ;
    rdfs:seeAlso <https://www.cdc.gov/brfss/annual_data/2022/pdf/codebook22_llcp-v2-508.pdf> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-q9vmn1cvdclgr757aer5v1rg a sdc4-meta:ModelComponent ;
    rdfs:label "Observation Status" ;
    rdfs:comment "The status of the observation result. FHIR Observation.status; ObservationStatus, version 4.0.1." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-qsetd453kk9own8co1wmc5cz a sdc4-meta:ModelComponent ;
    rdfs:label "Marital Status" ;
    rdfs:comment "A demographic parameter indicating a person's current conjugal status. Question text: What is your current marital status? NIH CDE Repository, steward NIMHD, tinyId C6SezX_mKG, NIH endorsed." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-oy35qocyvn0zxq8ni4azvz39 a sdc4-meta:ModelComponent ;
    rdfs:label "Employment Status" ;
    rdfs:comment "The state of a person with regard to earning wages or salary. Question text: We would like to know about what you do: are you working now, looking for work, retired, keeping house, a student, or what? NIH CDE Repository, steward NIMHD, tinyId RME88_Wg_hV, NIH endorsed." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-crdh278iwq7azbtcgsuxteve a sdc4-meta:ModelComponent ;
    rdfs:label "Income Level (INCOME3)" ;
    rdfs:comment "Annual household income from all sources in the agency's ranges (INCOME3). Not harmonized: the ranges do not nest with NHANES's or the NIH CDE's." ;
    rdfs:seeAlso <https://www.cdc.gov/brfss/annual_data/2022/pdf/codebook22_llcp-v2-508.pdf> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-d1evlz8yvdlwt6ia9fjq4pgj a sdc4-meta:ModelComponent ;
    rdfs:label "Purpose of Use" ;
    rdfs:comment "Why the information was used (HL7 v3 ActReason purpose of use). Activity context, not an access-control tag." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-evbpc370eyfc3q3lldwifu78 a sdc4-meta:ModelComponent ;
    rdfs:label "Primary Source of Health Insurance (PRIMINSR)" ;
    rdfs:comment "The current primary source of health insurance coverage (PRIMINSR). Kept beside the NIH CDE Category of Health Insurance it is mapped to." ;
    rdfs:seeAlso <https://www.cdc.gov/brfss/annual_data/2022/pdf/codebook22_llcp-v2-508.pdf> ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-jujsdur1igws8orw6tvvlqco a sdc4-meta:ModelComponent ;
    rdfs:label "Provenance Agent Type" ;
    rdfs:comment "The functional role of an agent in an activity (FHIR Provenance.agent.type)." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

sdc4:mc-xtbtk7ro6s9247bcwt4ak4h1 a sdc4-meta:ModelComponent ;
    rdfs:label "Current Educational Attainment" ;
    rdfs:comment "A textual description of the grade or highest level of education attained by a human being. Question text: What is the highest grade or level of school you have completed or the highest degree you have received? NIH CDE Repository, steward Project 5, tinyId Co2d1RyYS3, NIH endorsed." ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdTokenType> .

