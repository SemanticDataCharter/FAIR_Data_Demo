    sh:targetNode sdc4:mc-wesa1iwagjckq500ixmosu2l ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-wl6j4ekcmu4hvt2m12zw4zp8-shape a sh:NodeShape ;
    rdfs:label "Activity Status" ;
    rdfs:comment "The state of an activity, from the Data Privacy Vocabulary activity status concepts." ;
    sh:node sdc4:XdTokenBaseShape ;
    sh:property [ sh:hasValue <https://w3id.org/dpv#ActivityStatus> ;
            sh:path skos:closeMatch ],
        [ sh:datatype xsd:token ;
            sh:in ( "ActivityProposed" "ActivityPlanned" "ActivityOngoing" "ActivityHalted" "ActivityCompleted" "ActivityNotCompleted" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <https://w3id.org/dpv> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/activity-status> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue sdc4:mc-yehcpzf43j0b5zp9ck59t9eg ;
            sh:path prov:wasRevisionOf ] ;
    sh:targetNode sdc4:mc-wl6j4ekcmu4hvt2m12zw4zp8 ;
    sdc4-meta:sdcType "XdTokenType" .

