# Cross-Study Medical History
# Medical history components shared across all three studies.
# Demonstrates that patient history data is structurally interoperable.
#
# Placeholder — real ct_id URIs will be populated after model generation.

PREFIX sdc4: <https://datacharterontology.org/sdc4/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?ctId ?label ?study ?dataType ?description
WHERE {
    ?component a sdc4:Component ;
               sdc4:ctId ?ctId ;
               rdfs:label ?label ;
               sdc4:domain "Medical History" ;
               sdc4:study ?study ;
               sdc4:dataType ?dataType .
    OPTIONAL { ?component sdc4:description ?description . }
}
ORDER BY ?label ?study
