    sh:property [ sh:hasValue <http://terminology.hl7.org/CodeSystem/v3-Confidentiality> ;
            sh:path skos:exactMatch ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue sdc4:mc-hp8q52t8tgmis92c4ljrfy7e ;
            sh:path prov:wasRevisionOf ],
        [ sh:datatype xsd:token ;
            sh:in ( "U" "L" "M" "N" "R" "V" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ],
        [ sh:hasValue <http://terminology.hl7.org/> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/confidentiality> ;
            sh:path dcterms:identifier ] ;
    sh:targetNode sdc4:mc-vbctgmdcwps5b3r3l6sboa6y ;
    sdc4-meta:sdcType "XdTokenType" .

sdc4:mc-vhezo2cckpe92x4c3j2memeh-shape a sh:NodeShape ;
    rdfs:label "Had Plan Reference" ;
    rdfs:comment "The plan the activity followed (prov:hadPlan). Holds the IRI of the referenced thing." ;
    sh:node sdc4:XdStringBaseShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ;
            sh:pattern "\\S+" ],
        [ sh:hasValue <https://www.w3.org/TR/prov-o/> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/had-plan-reference> ;
            sh:path dcterms:identifier ],
        [ sh:hasValue sdc4:mc-xvdfh1nzfar33yxmgl3jgvqo ;
            sh:path prov:wasRevisionOf ],
        [ sh:hasValue prov:hadPlan ;
            sh:path skos:exactMatch ] ;
    sh:targetNode sdc4:mc-vhezo2cckpe92x4c3j2memeh ;
    sdc4-meta:sdcType "XdStringType" .

sdc4:mc-vi7yvq0b8nler3g6alaamrzm-shape a sh:NodeShape ;
    rdfs:label "Body Site Code (SNOMED CT)" ;
