    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdstring-value ;
            sh:pattern "\\S+" ],
        [ sh:hasValue prov:wasQuotedFrom ;
            sh:path skos:exactMatch ],
        [ sh:hasValue sdc4:mc-q69bq5dd4e3v0z8ybm578y89 ;
            sh:path prov:wasRevisionOf ],
        [ sh:hasValue <https://www.w3.org/TR/prov-o/> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <https://axius-sdc.com/library/provgov/was-quoted-from-reference> ;
            sh:path dcterms:identifier ] ;
    sh:targetNode sdc4:mc-mjl0vv39zsbigqiuyqm66fkv ;
    sdc4-meta:sdcType "XdStringType" .

