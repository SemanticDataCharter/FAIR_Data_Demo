sdc4:mc-a08lkh4xjvqqjtz7sxy129pa-shape a sh:NodeShape ;
    rdfs:label "Exercise in Past 30 Days (EXERANY2)" ;
    rdfs:comment "Whether the respondent took part in any physical activity or exercise in the past month other than their regular job (EXERANY2)." ;
