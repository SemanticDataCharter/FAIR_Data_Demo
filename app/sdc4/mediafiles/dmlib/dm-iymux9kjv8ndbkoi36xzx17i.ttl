    rdfs:label "Number of Children in Household (CHILDREN)" ;
    rdfs:comment "The number of children less than 18 years of age in the household (CHILDREN)." ;
    rdfs:seeAlso <https://www.cdc.gov/brfss/annual_data/2022/pdf/codebook22_llcp-v2-508.pdf> ;
    sdc4-meta:hasUnit sdc4:mc-c3ycqqk7ns1bvmsc0ricnsbn ;
    sdc4-meta:isConstrainedByRmComponent <https://semanticdatacharter.com/ns/sdc4/sdc4.xsd#XdCountType> .

