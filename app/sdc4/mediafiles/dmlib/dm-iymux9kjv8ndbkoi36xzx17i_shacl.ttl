        [ sh:datatype xsd:token ;
            sh:in ( "Yes" "No" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ] ;
    sh:targetNode sdc4:mc-a08lkh4xjvqqjtz7sxy129pa ;
    sdc4-meta:sdcType "XdTokenType" .

