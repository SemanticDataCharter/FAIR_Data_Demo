sdc4:mc-awvbv44gmq5co6prxcnhdz09-shape a sh:NodeShape ;
    rdfs:label "Admit Source" ;
    rdfs:comment "Where the patient was admitted from. FHIR Encounter.hospitalization.admitSource; Admit source, version 4.0.1." ;
