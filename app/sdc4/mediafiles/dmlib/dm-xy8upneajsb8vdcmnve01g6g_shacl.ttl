        [ sh:hasValue <https://wwwn.cdc.gov/nchs/nhanes/continuousnhanes/default.aspx?BeginYear=2017> ;
            sh:path dcterms:source ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:datatype xsd:token ;
            sh:in ( "$0 to $4,999" "$5,000 to $9,999" "$10,000 to $14,999" "$15,000 to $19,999" "$20,000 to $24,999" "$25,000 to $34,999" "$35,000 to $44,999" "$45,000 to $54,999" "$55,000 to $64,999" "$65,000 to $74,999" "$20,000 and Over" "Under $20,000" "$75,000 to $99,999" "$100,000 and Over" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdtoken-value ],
        [ sh:hasValue <https://axius-sdc.com/library/fair/nhanes-annual-household-income> ;
            sh:path dcterms:identifier ] ;
    sh:targetNode sdc4:mc-ex88a2s3ys6hm5pvv77j0q2u ;
    sdc4-meta:sdcType "XdTokenType" .

