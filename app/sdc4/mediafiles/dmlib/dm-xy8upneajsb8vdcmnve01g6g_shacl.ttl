            sh:path dcterms:source ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path sdc4:xdquantity-value ],
        [ sh:hasValue sdc4:mc-ebtwma3vz90nci5or2gtxx0d ;
            sh:path sdc4-meta:hasUnit ],
        [ sh:hasValue <https://axius-sdc.com> ;
            sh:path dcterms:publisher ],
        [ sh:hasValue <https://wwwn.cdc.gov/Nchs/Nhanes/2017-2018/CBC_J.htm#LBDNENO> ;
            sh:path rdfs:seeAlso ] ;
    sh:targetNode sdc4:mc-a3bccid1kdgem2m5rix68o1y ;
    sdc4-meta:sdcType "XdQuantityType" .

